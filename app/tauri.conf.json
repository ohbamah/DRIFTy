{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DRIFTy",
  "mainBinaryName": "DRIFTy",
  "version": "0.1.0",
  "identifier": "dev.drifty.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "copyright": "DRIFTy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/claudiusd"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
